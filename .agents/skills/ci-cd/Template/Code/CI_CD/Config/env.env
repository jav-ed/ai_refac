# Project CI/CD variables for this repo.
#
# This file is intentionally the single place for project-owned deploy config.
# Do not invent values here: wrong deploy targets can overwrite existing sites.
# Woodpecker provides event variables such as CI_COMMIT_BRANCH, CI_COMMIT_SHA,
# CI_REPO, and CI_PIPELINE_NUMBER. Do not define those here.

# Marker used by Code/CI_CD/Lib/runtime.sh to prove that this file was loaded.
CI_CONFIG_LOADED="1"

# Org-wide compressor binary used after the Astro build. This is a shared tool
# path on the local Woodpecker agent machine, not a project-local dependency.
CI_COMPRESSOR_BIN="/home/jav/Schreibtisch/Javed/0_Right_Sirat/1_Code/01_Projects/07_Infrastruc/02_Web_Tools/02_Workfl_Comp/Compressor/target/release/compressor"

# Org-wide OG image generator. It reads this project's Cache/Og_Gen manifest
# and writes generated social-card images into this project's dist folder.
CI_OG_IMAGE_DIR="/home/jav/Schreibtisch/Javed/0_Right_Sirat/1_Code/01_Projects/07_Infrastruc/02_Web_Tools/02_Workfl_Comp/Og_Image"

# SSH alias for the deploy host. Must match the agent user's SSH config.
CI_DEPLOY_HOST="g12"

# Root folder that contains domain-named static site folders on the deploy host.
CI_DEPLOYMENT_ROOT="/home/javed/Desk/Zetun_Web/10_Web_Runtime/Web_Layer/20_Static_Websites/10_Public_Facing"

# Domain folder below CI_DEPLOYMENT_ROOT. This keeps the shared runtime root and
# the project identity separate, so copied configs must set the domain directly.
#
# INTENTIONAL SYNTAX BREAK:
# Complete this line before running the template. The missing closing quote is a
# safety measure so a copied project cannot deploy with an invented/default
# domain. Example final value: CI_DEPLOY_DOMAIN="example.com"
CI_DEPLOY_DOMAIN="

# Number of releases retained per deploy environment for rollback.
CI_DEPLOY_KEEP_RELEASES="5"
