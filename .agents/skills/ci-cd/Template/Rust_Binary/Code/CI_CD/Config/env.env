# Project-owned Rust build and remote installation contract.
CI_CONFIG_LOADED="1"

# Exact non-interactive Rust environment used locally and by Woodpecker.
CI_RUST_TOOLCHAIN="__SET_EXACT_RUST_TOOLCHAIN__"
CI_RUSTUP_BIN="__SET_ABSOLUTE_RUSTUP_BIN__"
CI_RUSTUP_HOME="__SET_ABSOLUTE_RUSTUP_HOME__"
CI_CARGO_HOME="__SET_ABSOLUTE_CARGO_HOME__"

# Built artifact and reviewed remote installation target.
CI_BINARY_NAME="__SET_BINARY_NAME__"
CI_INSTALL_HOST="__SET_SSH_HOST_ALIAS__"
CI_INSTALL_PATH="__SET_ABSOLUTE_REMOTE_BINARY_PATH__"
